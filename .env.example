# Re-analysing the published predictions needs HF_TOKEN. The gold labels come from
# LLM-AggreFact, which is the one input NOT in this package: the analysis downloads the
# pinned dev parquet from https://huggingface.co/datasets/lytang/LLM-AggreFact, that
# dataset is gated, and a token whose account has not clicked "Agree" on that page gets a
# 401. The API keys are needed only to re-run the models.
HF_TOKEN=
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Container user. docker-compose.yml here defaults both to 1000; set them to your host's
# `id -u` / `id -g` if yours differ, or the container cannot write its caches and uv
# fails with "Permission denied" on /opt/uv-cache. Do not `source .env` in bash: UID is
# read-only there.
UID=1000
GID=1000
